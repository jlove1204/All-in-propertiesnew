{
  "version": 2,
  "builds": [
    {
      "src": "api.js",
      "use": "@vercel/node"
    },
    {
      "src": "webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "policies.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/stripe-webhook",
      "dest": "/webhook.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api.js"
    },
    {
      "src": "/admin/?",
      "dest": "/admin.html"
    },
    {
      "src": "/policies/?",
      "dest": "/policies.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}